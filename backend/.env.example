# The Bike Yard Dealership Environment Variables
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/thebikeyard?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-byte-hex-in-production"
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
DEFAULT_DEALERSHIP_CODE="TBY-THANE-01"

# Comma-separated SPA origins allowed to call safe read-only API routes
# (GET /api/health, GET /api/catalog/bikewale). Required for cross-origin SPA.
# Example: https://the-bike-yard.vercel.app,http://localhost:5173
CORS_ORIGINS=

# --- WhatsApp Cloud API (Meta test number first; NEVER use real showroom number in test phase) ---
WHATSAPP_MODE=test
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Set true ONLY after owner approval + Meta eligibility checks (M8). Blocks unsafe prod assumptions.
WHATSAPP_PRODUCTION_APPROVED=false

# --- AI provider (customer-facing assistant only; adapter-based) ---
AI_PROVIDER=none
AI_MODEL=
# Gemini example (if AI_PROVIDER=gemini): uses existing GEMINI_API_KEY
AI_TIMEOUT_MS=12000


# Approved reference catalogue provider and licensed HTTPS image hostnames.
BIKEWALE_APPROVED_FEED_URL=
BIKEWALE_APPROVED_FEED_HOST=
BIKEWALE_APPROVED_IMAGE_HOSTS=
